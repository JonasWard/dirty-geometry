    "Geometry2Input": { "or": ["Geometry2", ["Geometry2"]] },
    "Grid2Constraint": { "enum": ["unconstrained", "u", "v", "both"] },
    "Grid2Options": { "object": { "u": { "type": "Axis", "optional": true }, "v": { "type": "Axis", "optional": true }, "epsilon": { "type": "Epsilon", "optional": true }, "frame": { "type": "Frame2", "optional": true } } },
